# Exchange server (EWS endpoint)
EXCHANGE_SERVER=https://mail.company.com/EWS/Exchange.asmx

# Credentials — fill these in
# Exactly one backslash: dotenv does not process escape sequences, so
# DOMAIN\\username would reach the server with both backslashes intact.
EXCHANGE_USERNAME=DOMAIN\username
EXCHANGE_PASSWORD=your-password
EXCHANGE_EMAIL_ADDRESS=user@company.com

# Auth: NTLM (Windows domain) or Basic
EXCHANGE_AUTH_TYPE=NTLM

# Basic auth sends credentials in the clear over http:// — the server refuses to start
# with EXCHANGE_AUTH_TYPE=Basic and an http:// EXCHANGE_SERVER unless this is set true.
# Only for local/test servers you control; leave false otherwise.
EXCHANGE_ALLOW_INSECURE_BASIC_AUTH=false

# Set to false if the server uses a self-signed certificate
EXCHANGE_VERIFY_SSL=true

# Exchange version on your server
EXCHANGE_VERSION=EXCHANGE_2016

# Fallback timezone used only when Exchange reports an unresolvable GUID timezone id;
# normal operations use the mailbox's own default timezone instead
EXCHANGE_TIMEZONE_FALLBACK=Europe/Moscow

# Per-request timeout, in seconds (1-300)
EXCHANGE_TIMEOUT=30

# Total wall-clock budget for retrying read-only calls when Exchange reports itself
# busy, in seconds (0 disables retries). Writes (send/create/delete/...) are never
# auto-retried, since an ambiguous failure could mean the operation already happened.
EXCHANGE_MAX_RETRY_WAIT_SECONDS=90

# Mailbox to impersonate (requires Exchange impersonation permissions); leave unset to act as EXCHANGE_USERNAME
EXCHANGE_IMPERSONATE_AS=

# Max size (MB) for local files attached to outgoing email, and for attachments
# downloaded via get_attachment (1-100)
EXCHANGE_ATTACHMENT_MAX_SIZE_MB=10

# Max number of attachments allowed on a single send/reply/forward/create_draft call (1-100)
EXCHANGE_ATTACHMENT_MAX_COUNT=10

# Max combined size (MB) of all attachments on a single send/reply/forward/create_draft
# call (1-500)
EXCHANGE_ATTACHMENT_MAX_TOTAL_SIZE_MB=25

# Directory that outgoing attachment paths and get_attachment's save_path must stay
# within. Local file access is refused by default: leave unset and any non-empty
# `attachments` list or explicit save_path is rejected (get_attachment with no
# save_path still falls back to the system temp directory).
EXCHANGE_ATTACHMENT_ROOT=

# Max characters kept in get_email's body_text/body_html before truncating (1,000-5,000,000)
EXCHANGE_EMAIL_BODY_MAX_CHARS=200000

# Optional signature appended to outgoing mail (no EWS API exists for this).
# EXCHANGE_SIGNATURE_TEXT is used for text bodies and replies/forwards,
# EXCHANGE_SIGNATURE_HTML for html bodies. Leave empty to disable.
EXCHANGE_SIGNATURE_TEXT=
EXCHANGE_SIGNATURE_HTML=

# MCP transport: stdio or sse
MCP_TRANSPORT=stdio

# Host/port used when MCP_TRANSPORT=sse
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=8080

# Required when MCP_TRANSPORT=sse: clients must send this as `Authorization: Bearer <token>`.
# The server refuses to start over sse without it. Generate with e.g. `openssl rand -hex 32`.
MCP_SSE_AUTH_TOKEN=

# How many tool calls run at once; more calls than this queue to wait their turn.
# There is no per-call timeout setting: a blocking socket read cannot be
# interrupted, so a call is bounded by EXCHANGE_TIMEOUT plus
# EXCHANGE_MAX_RETRY_WAIT_SECONDS. Lower those to give up sooner.
MCP_MAX_CONCURRENCY=1

# Hard cap on tool calls admitted at once (running + waiting). Once this many are
# already admitted, further calls are rejected immediately with a server_busy error
# instead of queuing indefinitely.
MCP_MAX_QUEUE_SIZE=20

# DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO

# Log file path; leave unset to log to stderr
LOG_FILE=
